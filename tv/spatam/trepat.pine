// === DATA END ===

var map<string, string> m_min = map.new<string, string>()
var map<string, string> m_sec = map.new<string, string>()

if barstate.isfirst and str.length(TREPAT_DATA) > 0
    entries = str.split(TREPAT_DATA, "~")
    for e in entries
        kv = str.split(e, "|")
        if array.size(kv) == 2
            k = array.get(kv, 0)
            if str.length(k) == 12
                map.put(m_min, k, array.get(kv, 1))
            else if str.length(k) == 14
                map.put(m_sec, k, array.get(kv, 1))

// auto-detect timeframe: 15s chart -> second-precision keys, else minute keys
// (keys carry the full date — only the session the data belongs to lights up)
use_sec = timeframe.isseconds
key = str.format_time(time, use_sec ? "yyyyMMddHHmmss" : "yyyyMMddHHmm", "Asia/Kolkata")
msg = use_sec ? map.get(m_sec, key) : map.get(m_min, key)
has = not na(msg)

// cell color by the kind of message that minute (cosmetic only)
col(string s) =>
    swing = str.contains(s, "Swing") or str.contains(s, "Uptrend") or
         str.contains(s, "Downtrend") or str.contains(s, "Session open")
    cross = str.contains(s, "Cross") or str.contains(s, "PXD") or
         str.contains(s, "PXU") or str.contains(s, "M2X") or
         str.contains(s, "about to cross") or str.contains(s, "VWAP")
    lvl = str.contains(s, "support") or str.contains(s, "resistance") or
         str.contains(s, "level")
    swing ? color.new(color.purple, 0) :
         cross ? color.new(color.orange, 0) :
         lvl ? color.new(color.blue, 0) : color.new(color.gray, 0)

h = has ? 1.0 : 0.04
c = has ? col(msg) : color.new(color.gray, 88)

plot(h, "TREPAT", color=c, style=plot.style_columns)
// status readout (top-left of pane): entries loaded, TF branch, current bar key
var table st = table.new(position.top_left, 2, 2)
if barstate.islast
    table.cell(st, 0, 0, "entries", text_color = color.gray, text_size = size.small)
    table.cell(st, 1, 0, str.tostring(map.size(m_min) + map.size(m_sec)), text_color = color.gray, text_size = size.small)
    table.cell(st, 0, 1, "bar key", text_color = color.gray, text_size = size.small)
    table.cell(st, 1, 1, key + (has ? " ✓" : " (no data)"), text_color = color.gray, text_size = size.small)
// tooltips live on labels only (plot/box have none): a faint bubble sized to
// cover the column area — hover anywhere on the haze to read the messages
if has
    label.new(bar_index, 0.5, " \n \n ", xloc.bar_index, yloc.price,
         color.new(c, 88), label.style_label_center, color.new(color.white, 100),
         size.small, tooltip = msg)
