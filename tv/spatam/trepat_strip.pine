// === DATA END ===

var map<string, string> m_min = map.new<string, string>()
var map<string, string> m_sec = map.new<string, string>()

if barstate.isfirst and str.length(TREPAT_DATA) > 0
    parts = str.split(TREPAT_DATA, "|")
    if array.size(parts) >= 2
        for i = 0 to array.size(parts) - 2 by 2
            k = array.get(parts, i)
            if str.length(k) == 4
                map.put(m_min, k, array.get(parts, i + 1))
            else
                map.put(m_sec, k, array.get(parts, i + 1))

// auto-detect timeframe: 15s chart -> second-precision keys, else minute keys
use_sec = timeframe.isseconds
key = str.format_time(time, use_sec ? "HHmmss" : "HHmm", "Asia/Kolkata")
msg = use_sec ? map.get(m_sec, key) : map.get(m_min, key)
has = not na(msg)

// cell color by the kind of message that minute (cosmetic only)
col(string s) =>
    swing = str.contains(s, "Swing") or str.contains(s, "Uptrend") or
         str.contains(s, "Downtrend") or str.contains(s, "Session open")
    cross = str.contains(s, "Cross") or str.contains(s, "PXD") or
         str.contains(s, "PXU") or str.contains(s, "M2X") or
         str.contains(s, "about to cross") or str.contains(s, "VWAP")
    lvl = str.contains(s, "support") or str.contains(s, "resistance") or
         str.contains(s, "level")
    swing ? color.new(color.purple, 0) :
         cross ? color.new(color.orange, 0) :
         lvl ? color.new(color.blue, 0) : color.new(color.gray, 0)

h = has ? 1.0 : 0.04
c = has ? col(msg) : color.new(color.gray, 88)

plot(h, "TREPAT", color=c, style=plot.style_columns, tooltip=has ? msg : "")
