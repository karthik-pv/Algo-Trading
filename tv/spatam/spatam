            array.push(nearNow, nm)
            bool latched = false
            for ln in nearLatched
                if ln == nm
                    latched := true
            if not latched
                if dist > 0 and famPvt < 0
                    array.push(resNear, nm)
                else if dist < 0 and famPvt > 0
                    array.push(supNear, nm)
