bool barOK = alertsOn and barstate.isconfirmed
// 5-zone code for the 1m Stochastic (OSZ/NOSZ/MZ/NOBZ/OBZ) — appended to 1SX alerts
string k1m_zone_txt = k1m < 20 ? " OSZ" : k1m < 40 ? " NOSZ" : k1m < 60 ? " MZ" : k1m < 80 ? " NOBZ" : " OBZ"
// EMA21 on the CHART timeframe — with the chart on 15s this IS the 15s EMA21
float eChart21 = ta.ema(close, 21)

// — S/R + crossings at EMA levels (family #1) —
float[] alv = array.new_float()
string[] acd = array.new_string()
f_addLvl(_a, _n, _v, _nm) =>
    if not na(_v)
        array.push(_a, _v)
        array.push(_n, _nm)
f_addLvl(alv, acd, ema50_1m,  "1E50")
f_addLvl(alv, acd, ema100_1m, "1E1")
f_addLvl(alv, acd, ema200_1m, "1E2")
