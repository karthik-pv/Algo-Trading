//MACD----------------------------------------------------------------------------------------------------

macd_zcrosses() =>
    fastMA     = ta.ema(close, 24)
    slowMA     = ta.ema(close, 52)
    macdDiff   = fastMA - slowMA
    macdSignal = ta.ema(macdDiff, 9)
    macdHist   = macdDiff - macdSignal

    fastMA1     = ta.ema(close, 12)
    slowMA1     = ta.ema(close, 26)
    macdDiff1   = fastMA1 - slowMA1
    macdSignal1 = ta.ema(macdDiff1, 9)
    macdHist1   = macdDiff1 - macdSignal1

    ((ta.change(macdDiff) > 0 and macdHist < 0) or (ta.change(macdDiff1) > 0 and macdHist1 < 0))?  1 : ((ta.change(macdDiff) < 0 and macdHist > 0) or (ta.change(macdDiff1) < 0 and macdHist1 > 0)) ? -1 : 0
    

