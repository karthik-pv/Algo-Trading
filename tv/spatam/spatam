var float cPrev = na
var float vwapPrev = na
var bool below21 = false
var bool above50 = false
var bool e21Res = false
var bool e21Sup = false
var bool e50Sup = false
var bool e50Res = false
var int ret21Bar = -1000000
var int ret50Bar = -1000000
var bool pzcUp = false
var bool pzcDn = false
var bool was5Up = false
var bool was5Dn = false

if barOK and new1m and not na(c1m) and not na(o1m)
    // ---- aggressive-candle follow-through (checked BEFORE re-arming — catalog §2) ----
    for i = 0 to array.size(lvName) - 1
        int pb = array.get(lvPendB, i)
        if pb >= 0 and bar_index - pb > 15
            array.set(lvPendB, i, -1000000)
        else if pb >= 0 and bar_index > pb
            float val = array.get(lvVal, i)
            if not na(val) and not na(bavg5) and bavg5 > 0
                float body = math.abs(c1m - o1m)
                if body >= 1.5 * bavg5
                    bool isResP = array.get(lvPendR, i)
                    if not isResP and c1m > val and c1m > o1m
                        f_alert("Price rises above " + array.get(lvName, i))
                        array.set(lvPendB, i, -1000000)
                    else if isResP and c1m < val and c1m < o1m
                        f_alert("Price falls below " + array.get(lvName, i))
                        array.set(lvPendB, i, -1000000)

    // ---- touch engine (wick-aware range overlap, approach side) ----
    string[] tickRes = array.new_string()
    string[] tickSup = array.new_string()
    string[] contRes = array.new_string()
    string[] contSup = array.new_string()
    string[] firstRes = array.new_string()
    string[] firstSup = array.new_string()
    string[] againRes = array.new_string()
    string[] againSup = array.new_string()
    for i = 0 to array.size(lvName) - 1
        float val = array.get(lvVal, i)
        string nm = array.get(lvName, i)
        if na(val)
            continue
        bool inBand = (l1m - val) <= T_NEAR and (h1m - val) >= -T_NEAR
        if inBand
            if not array.get(lvAway, i)
                if c1m < val
                    array.push(contRes, nm)
                else
                    array.push(contSup, nm)
                continue
            bool first = array.get(lvTouch, i) == 0
            array.set(lvTouch, i, array.get(lvTouch, i) + 1)
            array.set(lvAway, i, false)
            // 1E21 / 1E50: touches within ~120s of a retrace line are suppressed
            if nm == "1E21" or nm == "1E50"
                int rb = nm == "1E21" ? ret21Bar : ret50Bar
                if bar_index - rb < 2
                    continue
            bool again = not first and array.get(lvTouch, i) >= 3
            if o1m >= val and c1m >= val
                array.push(tickSup, nm)
                if first
                    array.push(firstSup, nm)
                if again
                    array.push(againSup, nm)
            else if o1m <= val and c1m <= val
                array.push(tickRes, nm)
                if first
                    array.push(firstRes, nm)
                if again
                    array.push(againRes, nm)
        else if math.min(math.abs(l1m - val), math.abs(h1m - val)) > T_RETREAT and array.get(lvTouch, i) > 0
            array.set(lvAway, i, true)

    // ---- emit touch groups + may-cross + Expect + arm follow-through ----
    bool hasRes = array.size(tickRes) > 0
    bool hasSup = array.size(tickSup) > 0
    if hasRes or hasSup
        bool isRes = hasRes
        string[] tickN = array.new_string()
        if hasRes
            tickN := tickRes
        else
            tickN := tickSup
        // ride-along: levels already in contact on the same side merge into the group
        string[] contN = array.new_string()
        if hasRes
            contN := contRes
        else
            contN := contSup
        for cn in contN
            bool present = false
            for tn in tickN
                if tn == cn
                    present := true
            if not present
                array.push(tickN, cn)
        string grp = f_group(tickN)
        bool anyFirst = false
        bool anyAgain = false
        if isRes
            anyFirst := array.size(firstRes) > 0
            anyAgain := array.size(againRes) > 0
        else
            anyFirst := array.size(firstSup) > 0
            anyAgain := array.size(againSup) > 0
        string base = ""
        if anyFirst
            base := (isRes ? "Price facing resistance at " : "Price takes support of ") + grp + ".."
        else
            base := "Price retested the level " + grp + (anyAgain ? " again.." : "..")
        // remember acting level for 1PMX; arm follow-through for major EMA clusters
        if anyFirst
            if isRes
                lastResGrp := grp
            else
                lastSupGrp := grp
        for [i, nm] in lvName
            bool inGrp = false
            for tn in tickN
                if tn == nm
                    inGrp := true
            if inGrp and (str.contains(nm, "E50") or str.contains(nm, "E100") or str.contains(nm, "E200"))
                array.set(lvPendB, i, bar_index)
                array.set(lvPendR, i, isRes)
        // may-cross note (first touches only)
