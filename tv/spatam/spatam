kEma = "EMA"
kSma = "SMA"
kVwma = "VWMA"
kWma = "WMA"


// Input
pvt_maType = kEma
pvt_short = 3
pvt_long = 10
pvt_showTrend = false
pvt_showFill = true
pvt_showMa = true
pvt_oscMaType = kSma
pvt_maLength = 13
pvt_cross = true
pvt_shouldNormalize = true
pvt_normalizeLookback = 25

smooth(t, sig, len) =>
    ma = float(sig)         // None
    if t == kSma            // Simple
        ma := ta.sma(sig, len)
    if t == kEma            // Exponential
        ma := ta.ema(sig, len)
    if t == kWma            // Weighted
        ma := ta.wma(sig, len)
    if t == kVwma           // Volume Weighted
        ma := ta.vwma(sig, len)
    ma

calc_pvt(ma, sig, short, long) =>
    src = sig
    vt = ta.cum(ta.change(src) / src[1] * volume)
    sh = smooth(ma, vt, short)
    lg = smooth(ma, vt, long)
    sh - lg


maxAbs(series, len) =>
    max = float(0)
    for i = 0 to len-1
        max := math.max(max, math.abs(series[i]))
    max

pvt_stats()=>
    raw_pvt = calc_pvt(pvt_maType, close, pvt_short, pvt_long)
    maxAbs_pvt = maxAbs(raw_pvt, pvt_normalizeLookback)
    range_pvt = 1.0 // range to fit values into
    value_pvt= pvt_shouldNormalize? raw_pvt / maxAbs_pvt * range_pvt: raw_pvt
    
    pvt_poise_flag = value_pvt > value_pvt[1] ? 1 : -1
    pvt_trend_flag = value_pvt > 0 ? 1 : -1
    pvt_cross_over_index = ta.barssince(ta.crossover(value_pvt,0))+1
    pvt_cross_under_index = ta.barssince(ta.crossunder(value_pvt,0))+1
    
    [value_pvt,pvt_poise_flag,pvt_trend_flag,pvt_cross_over_index,pvt_cross_under_index]

// Combined PVT + MACD engine — ONE security request per timeframe
// (TV counts unique function×resolution pairs; merging halves the count)
f_engine_stats() =>
    [value_pvt, pvt_poise_flag, pvt_trend_flag, pvt_cross_over_index, pvt_cross_under_index] = pvt_stats()
    [macdTrend, macdTrend_1226, macdPoise, macdZCross, m_xu, m_xd, m_xu_1226, m_xd_1226] = macd_stats()
    [value_pvt, pvt_poise_flag, pvt_trend_flag, pvt_cross_over_index, pvt_cross_under_index, macdTrend, macdTrend_1226, macdPoise, macdZCross, m_xu, m_xd, m_xu_1226, m_xd_1226]

engine_stats_res(_res)=>
    [value_pvt, pvt_poise_flag, pvt_trend_flag, pvt_xu, pvt_xd, m2t, m1t, mpoise, mzc, m_xu, m_xd, m_xu_1226, m_xd_1226] = request.security(syminfo.tickerid, _res, f_engine_stats(), lookahead = barmerge.lookahead_on)
