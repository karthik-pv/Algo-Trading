    [macdline >  signalLine? 1: -1 , macdline_1226 >  signalLine_1226? 1: -1 ,macdline > macdline[1] ? 1: -1, macd_zcrosses(),  ta.barssince(ta.crossover(macdline,signalLine))+1,ta.barssince(ta.crossunder(macdline,signalLine))+1,ta.barssince(ta.crossover(macdline_1226,signalLine_1226))+1,ta.barssince(ta.crossunder(macdline_1226,signalLine_1226))+1]

