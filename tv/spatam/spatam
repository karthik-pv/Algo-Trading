//Stochastic-----------------------------------------------------------------------------------
//Returns k value and k's poise flag

get_stochastic_stats(ki,di)=>
    
    k = ta.sma(ta.stoch(ta.rsi(close, 14), ta.rsi(close, 14), ta.rsi(close, 14), 14), ki)
    d = ta.sma(ta.sma(ta.stoch(ta.rsi(close, 14), ta.rsi(close, 14), ta.rsi(close, 14), 14), di), ki)
    [k, k > d ? 1 :-1, k>k[1] ? 1: -1, ta.barssince(ta.crossover(k,d))+1,ta.barssince(ta.crossunder(k,d))+1 ]

get_stochastic_stats_res(_res,ki,di)=>
    [k,k_trend_flag,k_poise_flag,k_crossover_index,k_crossunder_index] = request.security(syminfo.tickerid, _res, get_stochastic_stats(ki,di), gaps=barmerge.gaps_off)

// 1m Stochastic — user's config: K = SMA(stoch,6), D = SMA(K,3)
get_stochastic_stats_1m()=>
    _st = ta.stoch(ta.rsi(close, 14), ta.rsi(close, 14), ta.rsi(close, 14), 14)
    k = ta.sma(_st, 6)
    d = ta.sma(k, 3)
    [k, d, k > d ? 1 : -1, k > k[1] ? 1 : -1, ta.barssince(ta.crossover(k, d))+1, ta.barssince(ta.crossunder(k, d))+1]

