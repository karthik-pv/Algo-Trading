f_paneGov(int _p, string _n) =>
    _p == 0 ? (_n == "1E100" or _n == "1E200") : _p == 1 ? (_n == "5E50" or _n == "5E100" or _n == "5E200") : _p == 2 ? (_n == "3E50" or _n == "3E100" or _n == "3E200") : _p == 3 ? (_n == "2E50" or _n == "2E100" or _n == "2E200") : (_n == "DE50" or _n == "DE100" or _n == "DE200")
f_paneUp(int _p) =>
