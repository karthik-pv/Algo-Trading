f_addLvl(alv, acd, ema100_5m, "5E1")
f_addLvl(alv, acd, ema200_5m, "5E2")
f_addLvl(alv, acd, ema50_30m, "3E50")
f_addLvl(alv, acd, ema100_30m, "3E1")
f_addLvl(alv, acd, ema200_30m, "3E2")
