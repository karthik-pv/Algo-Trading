// Developing-period floor pivots — pure math on the developing OHLC (no extra security pull)
f_devPivots(_h, _l, _o, _c) =>
    _P  = (_h + _l + _c) / 3
    _R1 = _P * 2 - _l
    _S1 = _P * 2 - _h
    _R2 = _P + (_h - _l)
    _S2 = _P - (_h - _l)
    _R3 = _P * 2 + (_h - 2 * _l)
    _S3 = _P * 2 - (2 * _h - _l)
    _R4 = _P * 3 + (_h - 3 * _l)
    _S4 = _P * 3 - (3 * _h - _l)
    _R5 = _P * 4 + (_h - 4 * _l)
    _S5 = _P * 4 - (4 * _h - _l)
    [_P, _R1, _R2, _R3, _R4, _R5, _S1, _S2, _S3, _S4, _S5]




// Floor pivots from the PREVIOUS COMPLETED period - fixed for the whole period, non-repainting
// (same basis as PSR_WMQ). Used for the current D/W/M/Q rows; the NEXT day/week projection
// is computed locally (f_devPivots) from the developing D/W OHLC pulls.
get_PrevPeriodPivots() =>
    prevHigh = high[1]
    prevLow = low[1]
    prevClose = close[1]

    P = (prevHigh + prevLow + prevClose) / 3
    R1 = P * 2 - prevLow
    S1 = P * 2 - prevHigh
    R2 = P + (prevHigh - prevLow)
    S2 = P - (prevHigh - prevLow)
    R3 = P * 2 + (prevHigh - 2 * prevLow)
    S3 = P * 2 - (2 * prevHigh - prevLow)
    R4 = P * 3 + (prevHigh - 3 * prevLow)
    S4 = P * 3 - (3 * prevHigh - prevLow)
    R5 = P * 4 + (prevHigh - 4 * prevLow)
    S5 = P * 4 - (4 * prevHigh - prevLow)

    [P,R1,R2,R3,R4,R5,S1,S2,S3,S4,S5, prevHigh, prevLow, prevClose]


