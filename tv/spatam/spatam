bool  s1EntUp   = false
bool  s1EntDn   = false
bool  s1ExitEvt = false
float s1ExitPts = na

if barstate.isconfirmed and scen1On
    // exits first
    if s1State == 1
        bool hitTgt = scen1TgtPts > 0 and high >= s1Entry + scen1TgtPts
        bool hitSl  = scen1SlPts  > 0 and low  <= s1Entry - scen1SlPts
        bool ema9X  = close < ema9_1m
        if hitTgt or hitSl or ema9X
            float exitPx = hitTgt ? s1Entry + scen1TgtPts : hitSl ? s1Entry - scen1SlPts : close
            float pts = exitPx - s1Entry
            s1Trades += 1
            s1TotPts += pts
            if pts >= 0
                s1Wins += 1
            else
                s1Losses += 1
            s1ExitEvt := true
            s1ExitPts := pts
            f_alert("SCEN 5PX_1o_15PM LONG exit @ " + str.tostring(math.round(exitPx)) + " (" + (pts >= 0 ? "+" : "") + str.tostring(pts, "#.##") + " pts)")
            s1State := 0
            s1Entry := na
    else if s1State == -1
        bool hitTgt = scen1TgtPts > 0 and low  <= s1Entry - scen1TgtPts
        bool hitSl  = scen1SlPts  > 0 and high >= s1Entry + scen1SlPts
        bool ema9X  = close > ema9_1m
        if hitTgt or hitSl or ema9X
            float exitPx = hitTgt ? s1Entry - scen1TgtPts : hitSl ? s1Entry + scen1SlPts : close
            float pts = s1Entry - exitPx
            s1Trades += 1
            s1TotPts += pts
            if pts >= 0
                s1Wins += 1
            else
                s1Losses += 1
            s1ExitEvt := true
            s1ExitPts := pts
            f_alert("SCEN 5PX_1o_15PM SHORT exit @ " + str.tostring(math.round(exitPx)) + " (" + (pts >= 0 ? "+" : "") + str.tostring(pts, "#.##") + " pts)")
