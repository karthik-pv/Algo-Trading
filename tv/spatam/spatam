//─ Alert Log machinery (from Lookouts) ─────────────────────────────────────────────────────────────
var string[] logMsgs = array.new_string()
var int[]   logNos   = array.new_int()
var float[] logTss   = array.new_float()
var color[] logBgs   = array.new_color()
var int[]   logSeq   = array.new_int(1, 0)
var string[] alertQ  = array.new_string()
var string[] alertTs = array.new_string()   // exact IST fire-time (HH:MM:SS) per queued alert

f_msg_bg(_msg) =>
    int L = str.length(_msg)
    string tail2 = L >= 2 ? str.substring(_msg, L - 2, L) : _msg
    color c = color.white
    if tail2 == "UT" or str.contains(_msg, " UT") or str.contains(_msg, "Cross Up") or str.contains(_msg, "Crossing up") or str.contains(_msg, "could support") or str.contains(_msg, "Support")
        c := color.green
    else if tail2 == "DT" or str.contains(_msg, " DT") or str.contains(_msg, "Cross Down") or str.contains(_msg, "Crossing down") or str.contains(_msg, "could resist") or str.contains(_msg, "Resistance") or str.contains(_msg, "ends")
        c := color.red
    else if str.contains(_msg, "Pz") or str.contains(_msg, "M2z") or str.contains(_msg, "Momentum Lost")
        c := color.yellow
    c

f_hhmmss(_ms) =>
    int h = hour(int(_ms), "Asia/Kolkata")
    int m = minute(int(_ms), "Asia/Kolkata")
    int s = second(int(_ms), "Asia/Kolkata")
    (h < 10 ? "0" : "") + str.tostring(h) + ":" + (m < 10 ? "0" : "") + str.tostring(m) + ":" + (s < 10 ? "0" : "") + str.tostring(s)

// f_alert stamps the Alert Log and QUEUES the message — one combined notification
// goes out per flush cadence, never directly.
f_alert(_msg) =>
    int _n = array.get(logSeq, 0) + 1
    array.set(logSeq, 0, _n)
    array.push(logMsgs, _msg)
    array.push(logNos, _n)
    array.push(logTss, timenow)
    array.push(logBgs, f_msg_bg(_msg))
    if not array.includes(alertQ, _msg)
        array.push(alertQ, _msg)
        array.push(alertTs, f_hhmmss(timenow))   // fire-time captured when the event queues (Option C)

// Log entries persist until pushed out by newer ones — capacity 30 lines.
while array.size(logMsgs) > 30
    array.shift(logMsgs)
    array.shift(logNos)
    array.shift(logTss)
    array.shift(logBgs)

// Deploy marker: seeded on the last historical bar so the log visibly shows the
// logger is working after every redeploy. Purged with the first ~10s of live data.
var bool logSeeded = false
if barstate.islastconfirmedhistory and not logSeeded
    logSeeded := true
    if array.size(logMsgs) == 0
        int _sn = array.get(logSeq, 0) + 1
        array.set(logSeq, 0, _sn)
        array.push(logMsgs, "SPATAM deployed — listening")
        array.push(logNos, _sn)
        array.push(logTss, timenow)
        array.push(logBgs, color.white)

// Flush: one combined alert() per flush cadence. Bar-based throttle (rollback-proof).
int flushBars = math.max(1, math.ceil(alertFlushInp / math.max(timeframe.in_seconds(), 1)))
var int lastFlushBar = -1000000
if array.size(alertQ) > 0 and bar_index - lastFlushBar >= flushBars
    while array.size(alertQ) > 20
        array.shift(alertQ)
        array.shift(alertTs)
    string flushTxt = str.replace_all(array.join(alertQ, "  "), "VWAP", "V WAP")
    // Option C (JSON): every queued alert carries its exact fire time —
    //   {"MSG":"ALERTS","SYM":…,"ALERTS":[{"T":"hh:mm:ss","TXT":"…"},…]}
    // The app iterates ALERTS → speaks the TXTs (joined) → appends "T | TXT" to the log file.
    // Text mode keeps the announcer's single-line format. Messages never contain quotes → JSON-safe.
    string recs = ""
    for i = 0 to array.size(alertQ) - 1
        recs += (i == 0 ? "" : ",") + '{"T":"' + array.get(alertTs, i) + '","TXT":"' + str.replace_all(array.get(alertQ, i), "VWAP", "V WAP") + '"}'
    alert(alertJsonOn ? '{"MSG":"ALERTS","SYM":"' + syminfo.tickerid + '","ALERTS":[' + recs + ']}' : flushTxt, alert.freq_once_per_bar)
    lastFlushBar := bar_index
    array.clear(alertQ)
    array.clear(alertTs)

