// Level row helpers: "value_name_distance" - value zero-padded to 6 digits and distance to 4
// so the string sort is numerically correct. na levels are skipped (no NaN rows).
f_fmtLevel(float lvl, string name) =>
    str.tostring(math.round(lvl), "000000") + "_" + name + "_" + str.tostring(math.abs(math.round(close) - math.round(lvl)))

// display helper: strip the leading zeros used by the sort key ("025000" -> "25000")
f_stripZeros(string s) =>
    string out = s
    while str.length(out) > 1 and str.startswith(out, "0")
        out := str.substring(out, 1)
    out

f_pushCur(float lvl, string name) =>        // current-day pivots: CW-CD only
    if not na(lvl)
        levels_array_curday_curwk.push(f_fmtLevel(lvl, name))

f_pushWeek(float lvl, string name) =>       // current-week pivots: CW-CD + CW-ND
    if not na(lvl)
        string s = f_fmtLevel(lvl, name)
        levels_array_curday_curwk.push(s)
        levels_array_nxtday_curwk.push(s)

f_pushAll(float lvl, string name) =>        // EMAs, M/Q pivots, extra levels: all three
    if not na(lvl)
        string s = f_fmtLevel(lvl, name)
        levels_array_curday_curwk.push(s)
        levels_array_nxtday_curwk.push(s)
        levels_array_nxtday_nxtwk.push(s)

f_pushNxtDay(float lvl, string name) =>     // next-day pivots: CW-ND + NW-ND
    if not na(lvl)
        string s = f_fmtLevel(lvl, name)
        levels_array_nxtday_curwk.push(s)
        levels_array_nxtday_nxtwk.push(s)

f_pushNxtWk(float lvl, string name) =>      // next-week pivots: NW-ND only
    if not na(lvl)
        levels_array_nxtday_nxtwk.push(f_fmtLevel(lvl, name))

