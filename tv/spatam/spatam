f_addLvl(alv, acd, ema100_2h, "2E1")
f_addLvl(alv, acd, ema200_2h, "2E2")
if dailyAlertsOn
    f_addLvl(alv, acd, ema100_d, "DE1")
    f_addLvl(alv, acd, ema200_d, "DE2")
if weeklyAlertsOn
    f_addLvl(alv, acd, ema100_w, "WE1")
    f_addLvl(alv, acd, ema200_w, "WE2")

// Group same-type level events into ONE message (Lookouts behaviour): 
// "Crossing down @ 1E50 and 1E1" instead of two separate alerts.
f_alertJoined(string _prefix, string[] _names) =>
    if array.size(_names) == 1
        f_alert(_prefix + array.get(_names, 0))
    else if array.size(_names) > 1
        string joined = ""
        for i = 0 to array.size(_names) - 1
            joined += (i == 0 ? "" : i == array.size(_names) - 1 ? " and " : ", ") + array.get(_names, i)
        f_alert(_prefix + joined)

if barOK and srAlertsOn and array.size(alv) > 0
    string[] supNames = array.new_string()
    string[] resNames = array.new_string()
    string[] xupNames = array.new_string()
    string[] xdnNames = array.new_string()
    for i = 0 to array.size(alv) - 1
        float lv = array.get(alv, i)
        string cd = array.get(acd, i)
        bool gateOK = str.startswith(cd, "D") ? dailyAlertsOn : str.startswith(cd, "W") ? weeklyAlertsOn : true
        if gateOK
            // Crossings (close-through) take precedence — S/R fire only on same-side retests
            if close > lv and close[1] <= lv
                array.push(xupNames, cd)
            else if close < lv and close[1] >= lv
                array.push(xdnNames, cd)
            else if low <= lv and close > lv
                array.push(supNames, cd)
            else if high >= lv and close < lv
                array.push(resNames, cd)
    f_alertJoined("Support @ ", supNames)
    f_alertJoined("Resistance @ ", resNames)
    f_alertJoined("Crossing up @ ", xupNames)
    f_alertJoined("Crossing down @ ", xdnNames)

// — Attention: price NEAR a level (within range, no touch yet) that could act as R/S.
//   R/S decided by the level's FAMILY trend (1P/5P/3P/2P/DP/WP — the Levels-Ladder tags):
//   level above price + family trend down → could provide resistance
//   level below price + family trend up   → could provide support
//   Each level latched while it stays near — re-announces only after price moves away. —
var string[] nearLatched = array.new_string()
float nearRange = 50.0
if barOK and srAlertsOn and array.size(alv) > 0
    string[] nearNow = array.new_string()
    string[] resNear = array.new_string()
    string[] supNear = array.new_string()
    for i = 0 to array.size(alv) - 1
        float lv = array.get(alv, i)
        string cd = array.get(acd, i)
        float dist = close - lv
        if math.abs(dist) <= nearRange
            float famPvt = str.startswith(cd, "1") ? value_pvt_1m : str.startswith(cd, "5") ? value_pvt_5m : str.startswith(cd, "3") ? value_pvt_30m : str.startswith(cd, "2") ? value_pvt_2h : str.startswith(cd, "D") ? value_pvt_d : value_pvt_w
            array.push(nearNow, cd)
            bool latched = false
            if array.size(nearLatched) > 0
                for j = 0 to array.size(nearLatched) - 1
                    if array.get(nearLatched, j) == cd
                        latched := true
            if not latched
                if dist > 0 and famPvt < 0
                    array.push(resNear, cd)
                else if dist < 0 and famPvt > 0
                    array.push(supNear, cd)
    if array.size(resNear) > 0
        string j = ""
        for i = 0 to array.size(resNear) - 1
            j += (i == 0 ? "" : ", ") + array.get(resNear, i)
        f_alert("Attention : " + j + " could provide resistance..")
    if array.size(supNear) > 0
        string j = ""
        for i = 0 to array.size(supNear) - 1
            j += (i == 0 ? "" : ", ") + array.get(supNear, i)
        f_alert("Attention : " + j + " could provide support..")
    array.clear(nearLatched)
    if array.size(nearNow) > 0
        for i = 0 to array.size(nearNow) - 1
            array.push(nearLatched, array.get(nearNow, i))

// — Attention: VWAP approach + cross (1m + 5m), up + down.
//   "About to cross" = price within vwapNearPts of VWAP on the wrong side + the driving PM trending.
//   "Crossed"       = actual cross + PM agreement. 5m cross derived from chart bars via 5m boundaries
//                     (no extra security pull — budget is full). Each "about to" latched per approach. —
bool pm15Up = pvt_trend_flag_15s == 1 and trend15s == 1
bool pm15Dn = pvt_trend_flag_15s == -1 and trend15s == -1
bool pm1Up  = pvt_trend_flag_1m == 1 and trend1 == 1
bool pm1Dn  = pvt_trend_flag_1m == -1 and trend1 == -1
float distVwap = vwapSession - close
bool nearBelow = not vwapUp and distVwap <= vwapNearPts and distVwap >= 0   // below VWAP, within range
bool nearAbove = vwapUp and (close - vwapSession) <= vwapNearPts            // above VWAP, within range
// 5m-bar side of VWAP, tracked on chart bars (boundary update — no pull):
var bool side5Up = na
var bool side5UpPrev = na
bool new5m = ta.change(time("5")) != 0
if new5m
    side5UpPrev := side5Up
    side5Up := close > vwapSession
bool xUp5 = new5m and side5Up and side5UpPrev == false
bool xDn5 = new5m and not side5Up and side5UpPrev == true
var bool abtUp1m = false
var bool abtDn1m = false
var bool abtUp5m = false
var bool abtDn5m = false
// Consolidation around VWAP: >=4 crosses within the last 40 chart bars = price hugging VWAP.
// Announce once at onset; while active, SUPPRESS the about-to/crossed attentions (anti-noise).
float crossCount40 = math.sum(vwapXUp1m ? 1 : 0, 40) + math.sum(vwapXDn1m ? 1 : 0, 40)
bool consolVwap   = crossCount40 >= 4
var bool consolAnnounced = false
// PM-trend STARTS (fresh transitions, not ongoing states):
bool pm5Up = value_pvt_5m > 0 and trend5 == 1
bool pm5Dn = value_pvt_5m < 0 and trend5 == -1
bool pm1StartUp = pm1Up and not pm1Up[1]
bool pm1StartDn = pm1Dn and not pm1Dn[1]
bool pm5StartUp = pm5Up and not pm5Up[1]
bool pm5StartDn = pm5Dn and not pm5Dn[1]
int  barsSinceXUp = ta.barssince(vwapXUp1m)
int  barsSinceXDn = ta.barssince(vwapXDn1m)
if barOK and vwapAlertsOn
    if consolVwap
        if not consolAnnounced
            f_alert("Attention : Price consolidating around VWAP..")
            consolAnnounced := true
    else
        consolAnnounced := false
    // 1m: about to cross up — 15PM uptrending, price below and near (suppressed while consolidating)
    if nearBelow and pm15Up and not consolVwap
        if not abtUp1m
            f_alert("Attention : Price about to cross up VWAP (1m)..")
            abtUp1m := true
    else
        abtUp1m := false
    // 1m: about to cross down — 15PM downtrending, price above and near (suppressed while consolidating)
    if nearAbove and pm15Dn and not consolVwap
        if not abtDn1m
            f_alert("Attention : Price about to cross down VWAP (1m)..")
            abtDn1m := true
    else
        abtDn1m := false
    // 5m: about to cross up — 1PM uptrending (suppressed while consolidating)
    if nearBelow and pm1Up and not consolVwap
        if not abtUp5m
            f_alert("Attention : Price about to cross up VWAP (5m)..")
            abtUp5m := true
    else
        abtUp5m := false
    // 5m: about to cross down — 1PM downtrending (suppressed while consolidating)
    if nearAbove and pm1Dn and not consolVwap
        if not abtDn5m
            f_alert("Attention : Price about to cross down VWAP (5m)..")
            abtDn5m := true
    else
        abtDn5m := false
    // Crossed (event fires on the cross bar itself, gated by PM agreement; suppressed while consolidating):
    if vwapXUp1m and (pm15Up or pm1Up) and not consolVwap
        f_alert("Attention : Price crossed up VWAP (1m)..")
    if vwapXDn1m and (pm15Dn or pm1Dn) and not consolVwap
        f_alert("Attention : Price crossed down VWAP (1m)..")
    if xUp5 and pm1Up and not consolVwap
        f_alert("Attention : Price crossed up VWAP (5m)..")
