// 4th column: trend tag of the family whose trend plays out at this level (Lookouts hand-out mapping).
// Text: "2P" (PVT alone) -> "2PM2" (MACD2 joins) -> "2PM" (MACD1 + MACD2 both join).
// Shade: dark when MACD2 agrees with the PVT trend, light when MACD2 is retracing against it.
f_familyTag(float _pvt, int _m1, int _m2, string _pfx) =>
    int pDir    = _pvt > 0 ? 1 : -1
    bool m1With = _m1 == pDir
    bool m2With = _m2 == pDir
    string txt  = _pfx + "P" + (m2With ? (m1With ? "M" : "M2") : m1With ? "M1" : "")
    color  bg   = pDir == 1 ? (m2With ? #02580b : #c5fab7) : m2With ? #f91c06 : #fab9b1
    color  fg   = m2With ? color.white : color.black
    [txt, bg, fg]

// Level -> family mapping (Lookouts hand-out + user extension):
// 5m trend plays at 1m EMA50 | 30m trend at 1m EMA100/200 | 2H trend at 5m EMA50/100/200
// D trend at 30m EMA50/100/200 | W trend at 2h EMA50/100/200 | Monthly trend at D EMA100/200
// Quarterly trend at W EMA100/200. All other levels: no tag.
f_levelTag(string _name) =>
    if _name == "1m EMA50"
        f_familyTag(value_pvt_5m, trend5_1226, trend5, "5")
    else if _name == "1m EMA100" or _name == "1m EMA200"
        f_familyTag(value_pvt_30m, trend30_1226, trend30, "3")
    else if _name == "5m EMA50" or _name == "5m EMA100" or _name == "5m EMA200"
        f_familyTag(value_pvt_2h, trend2h_1226, trend2h, "2")
    else if _name == "30m EMA50" or _name == "30m EMA100" or _name == "30m EMA200"
        f_familyTag(value_pvt_d, trendd_1226, trendd, "D")
    else if _name == "2h EMA50" or _name == "2h EMA100" or _name == "2h EMA200"
        f_familyTag(value_pvt_w, trendw_1226, trendw, "W")
    else if _name == "D EMA100" or _name == "D EMA200"
        f_familyTag(value_pvt_m, trendm_1226, trendm, "M")
    else if _name == "W EMA100" or _name == "W EMA200"
        f_familyTag(value_pvt_q, trendq_1226, trendq, "Q")
    else
        ["", color(na), color.white]

