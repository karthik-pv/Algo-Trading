    bool m2Dn = trend1 == -1
    bool pmxDn = (pvtDn and m2XDn) or (m2Dn and pvtXDn) or (pvtXDn and m2XDn)
    bool pmxUp = ((not pvtDn) and m2XUp) or ((not m2Dn) and pvtXUp) or (pvtXUp and m2XUp)
    if pmxDn
        f_alert(lastResGrp != "" ? "1PMX DT Resistance @ " + lastResGrp : "1PMX DT Resistance")
    else if pmxUp
        f_alert(lastSupGrp != "" ? "1PMX UT Support @ " + lastSupGrp : "1PMX UT Support")

    // ---- 1E50 cross (gated on 1m PVT agreement) + retrace-that-holds ----
    if not na(e50Prev) and not na(cPrev) and cPrev > e50Prev and c1m < ema50_1m
        above50 := false
        if value_pvt_1m < 0
            f_alert("Price has crossed below 1E50..")
    else if not na(e50Prev) and not na(cPrev) and cPrev < e50Prev and c1m > ema50_1m
        above50 := true
        if value_pvt_1m > 0
            f_alert("Price has crossed above 1E50..")
    if above50 and not na(ema50_1m) and math.abs(c1m - ema50_1m) <= T_NEAR and c1m > ema50_1m
        if not e50Sup
            e50Sup := true
            ret50Bar := bar_index
            f_alert("Price has retraced down to and taken support of 1E50..")
    else if not na(ema50_1m) and c1m - ema50_1m > T_RETREAT
        e50Sup := false
    if (not above50) and not na(ema50_1m) and math.abs(c1m - ema50_1m) <= T_NEAR and c1m < ema50_1m
        if not e50Res
            e50Res := true
            ret50Bar := bar_index
            f_alert("Price has retraced up to and faced resistance at 1E50..")
    else if not na(ema50_1m) and ema50_1m - c1m > T_RETREAT
        e50Res := false

    // ---- 1E21 retrace (state from close vs 1m EMA21) ----
    if not na(cPrev) and not na(ema21_1m)
        if not below21 and cPrev > ema21_1m and c1m < ema21_1m
            below21 := true
        else if below21 and cPrev < ema21_1m and c1m > ema21_1m
            below21 := false
    if below21 and not na(ema21_1m) and math.abs(c1m - ema21_1m) <= T_NEAR and c1m < ema21_1m
        if not e21Res
            e21Res := true
            ret21Bar := bar_index
            f_alert("Price has retraced up to and faced resistance at 1E21..")
    else if not na(ema21_1m) and ema21_1m - c1m > T_RETREAT
        e21Res := false
    if (not below21) and not na(ema21_1m) and math.abs(c1m - ema21_1m) <= T_NEAR and c1m > ema21_1m
        if not e21Sup
            e21Sup := true
            ret21Bar := bar_index
            f_alert("Price has retraced down to and taken support of 1E21..")
    else if not na(ema21_1m) and c1m - ema21_1m > T_RETREAT
        e21Sup := false

    // ---- 1m candle VWAP cross ----
    if not na(vwapPrev) and not na(cPrev) and cPrev > vwapPrev and c1m < vwapSession
        f_alert("Price crossed down VWAP (1m)..")
    else if not na(vwapPrev) and not na(cPrev) and cPrev < vwapPrev and c1m > vwapSession
        f_alert("Price crossed up VWAP (1m)..")

    // ---- 5PZ pre-call (5m PVT in ±0.1 band, 1m PVT + MACD2 falling/rising, once per episode) ----
    if value_pvt_5m > 0 and value_pvt_5m <= 0.1 and value_pvt_1m < 0 and poise1 == -1 and not pzcDn
        pzcDn := true
        pzcUp := false
        f_alert("5PZ DT")
    else if value_pvt_5m < 0 and value_pvt_5m >= -0.1 and value_pvt_1m > 0 and poise1 == 1 and not pzcUp
        pzcUp := true
        pzcDn := false
        f_alert("5PZ UT")
    else if math.abs(value_pvt_5m) > 0.1
        pzcDn := false
        pzcUp := false

    // ---- 5PM trend start + Bias (catalog §8 wording; tag "5PM" = PVT+M1+M2 all aligned) ----
    [tag5, tag5bg, tag5fg] = f_familyTag(value_pvt_5m, trend5_1226, trend5, "5")
    bool is5UpT = tag5 == "5PM" and value_pvt_5m > 0
    bool is5DnT = tag5 == "5PM" and value_pvt_5m < 0
    if biasAlertsOn
        if is5UpT and not was5Up
            bool aboveV = c1m > vwapSession
            f_alert("5PM Uptrend started..")
            f_alert("Bias is " + (aboveV ? "Strong Uptrend" : "Uptrend") + " as we have 5PM Uptrend" + (aboveV ? " above VWAP" : ""))
        if is5DnT and not was5Dn
            bool belowV = c1m < vwapSession
            f_alert("5PM Downtrend started..")
            f_alert("Bias is " + (belowV ? "Strong Downtrend" : "Downtrend") + " as we have 5PM Downtrend" + (belowV ? " below VWAP" : ""))
    was5Up := is5UpT
    was5Dn := is5DnT

    // carry 1m boundary values
    e50Prev := ema50_1m
    cPrev := c1m
    vwapPrev := vwapSession

