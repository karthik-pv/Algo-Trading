    table.cell(dash, 3, gridStart + 3, "WS", text_color = color.white, width = 9, bgcolor = #798095, text_halign = text.align_center, text_size = size.normal)

    table.cell(dash, 0, gridStart + 4, trend_3s, text_color = color.black, width = 9, bgcolor = bgcolor_3pm, text_halign = text.align_center, text_size = size.normal)
    table.cell(dash, 1, gridStart + 4, trend_2s, text_color = color.black, width = 9, bgcolor = bgcolor_2p,  text_halign = text.align_center, text_size = size.normal)
    table.cell(dash, 2, gridStart + 4, trend_ds, text_color = color.black, width = 9, bgcolor = bgcolor_dp,  text_halign = text.align_center, text_size = size.normal)
    table.cell(dash, 3, gridStart + 4, trend_ws, text_color = color.black, width = 9, bgcolor = bgcolor_wp,  text_halign = text.align_center, text_size = size.normal)

    // 4) ALERT LOG — bottom ~40% (from Lookouts; newest first).
    //    Messages span cols 1-5 (merged once) so long alerts can't stretch column 1
    //    and knock the Digest / Set Ups / mini-grid cells out of alignment.
    var bool logMerged = false
    if not logMerged
        logMerged := true
        for r = logStart to dashRowsInp - 1
            table.merge_cells(dash, 1, r, 5, r)
    table.cell(dash, 0, logStart, "Time", text_color = color.black, bgcolor = #cacfe0, text_halign = text.align_center, text_size = size.small)
    table.cell(dash, 1, logStart, "Alert", text_color = color.black, bgcolor = #cacfe0, text_halign = text.align_left, text_size = size.small)
    int nLog = array.size(logMsgs)
    if nLog > 0
        int rowsLog = math.min(nLog, logRows - 1)
        for k = 0 to rowsLog - 1
            int idx = nLog - 1 - k
            color bg = array.get(logBgs, idx)
            table.cell(dash, 0, logStart + 1 + k, f_hhmmss(array.get(logTss, idx)), text_color = color.black, bgcolor = bg, text_halign = text.align_center, text_size = size.small)
            table.cell(dash, 1, logStart + 1 + k, array.get(logMsgs, idx), text_color = color.black, bgcolor = bg, text_halign = text.align_left, text_size = size.small)

