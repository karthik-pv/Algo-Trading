                if gov and (isRes ? f_paneUp(p) : not f_paneUp(p))
                    array.push(panes, p == 0 ? "3P" : p == 1 ? "2P" : p == 2 ? "DP" : p == 3 ? "WP" : "MP")
            if array.size(panes) > 0
                string pl = array.join(panes, "/")
                may := isRes ? " May cross up since " + pl + (array.size(panes) > 1 ? " are uptrending.." : " is uptrending..") : " May cross down since " + pl + (array.size(panes) > 1 ? " are downtrending.." : " is downtrending..")
        f_alert(base + may)
        // Expect pre-call: 1m PVT trending INTO the level AND within ±0.1 of zero
        bool gate = math.abs(value_pvt_1m) <= 0.1 and (isRes ? value_pvt_1m > 0 : value_pvt_1m < 0)
        if gate
            f_alert(isRes ? "Expect 1PX_15PM DT" : "Expect 1PX_15PM UT")

    // ---- 1PMX swing start (catalog §6) ----
    bool pvtXDn = pvt_cross_under_index_1m == 1
    bool pvtXUp = pvt_cross_over_index_1m == 1
    bool m2XDn = y1 == 1
    bool m2XUp = x1 == 1
