// — touch detection + rolling recency —
bool s1supTouch = false   // dipped to a major level, closed above it (support held → "rose from")
bool s1resTouch = false   // rose to a major level, closed below it (resistance held → "fell from")
if array.size(s1lv) > 0
    for i = 0 to array.size(s1lv) - 1
        float s1lvv = array.get(s1lv, i)
        if low <= s1lvv and close > s1lvv
            s1supTouch := true
        if high >= s1lvv and close < s1lvv
            s1resTouch := true
var int s1supAge = 9999
var int s1resAge = 9999
if barstate.isconfirmed
    s1supAge := s1supTouch ? 0 : s1supAge + 1
    s1resAge := s1resTouch ? 0 : s1resAge + 1
bool s1supRecent = s1supAge <= scen1TouchN
bool s1resRecent = s1resAge <= scen1TouchN

// — 5m PVT cross opens the entry window; 1m VOC cross inside it arms; 15s PM fires the entry —
var int  s1pxWin  = 0
var bool s1pxUp   = false
var int  s1vocArm = -1
if barstate.isconfirmed
    if pvt_cross_over_index_5m == 1
        s1pxWin := scen1VocWin
        s1pxUp  := true
    else if pvt_cross_under_index_5m == 1
        s1pxWin := scen1VocWin
        s1pxUp  := false
    else if s1pxWin > 0
        s1pxWin -= 1
    if s1pxWin > 0 and voc_crossover_index_1m == 1
        s1vocArm := 0
    else if s1vocArm >= 0
        s1vocArm += 1
        if s1vocArm > scen1SyncN
            s1vocArm := -1

// — 15s PM cross events —
bool s1pm15Up = (pvt_cross_over_index_15s == 1 and trend15s == 1) or (x15s == 1 and value_pvt_15s > 0)
bool s1pm15Dn = (pvt_cross_under_index_15s == 1 and trend15s == -1) or (y15s == 1 and value_pvt_15s < 0)

// — trade state machine —
var int   s1State   = 0        // 0 flat · 1 long · -1 short
var float s1Entry   = na
var int   s1Trades  = 0
var int   s1Wins    = 0
var int   s1Losses  = 0
var float s1TotPts  = 0.0
bool  s1EntUp   = false
bool  s1EntDn   = false
bool  s1ExitEvt = false
float s1ExitPts = na

if barstate.isconfirmed and scen1On
    // exits first
    if s1State == 1
        bool hitTgt = scen1TgtPts > 0 and high >= s1Entry + scen1TgtPts
        bool hitSl  = scen1SlPts  > 0 and low  <= s1Entry - scen1SlPts
        bool ema9X  = close < ema9_1m
        if hitTgt or hitSl or ema9X
            float exitPx = hitTgt ? s1Entry + scen1TgtPts : hitSl ? s1Entry - scen1SlPts : close
            float pts = exitPx - s1Entry
            s1Trades += 1
            s1TotPts += pts
            if pts >= 0
                s1Wins += 1
            else
                s1Losses += 1
            s1ExitEvt := true
            s1ExitPts := pts
            f_alert("SCEN 5PX_1o_15PM LONG exit @ " + str.tostring(math.round(exitPx)) + " (" + (pts >= 0 ? "+" : "") + str.tostring(pts, "#.##") + " pts)")
            s1State := 0
            s1Entry := na
    else if s1State == -1
        bool hitTgt = scen1TgtPts > 0 and low  <= s1Entry - scen1TgtPts
        bool hitSl  = scen1SlPts  > 0 and high >= s1Entry + scen1SlPts
        bool ema9X  = close > ema9_1m
        if hitTgt or hitSl or ema9X
            float exitPx = hitTgt ? s1Entry - scen1TgtPts : hitSl ? s1Entry + scen1SlPts : close
            float pts = s1Entry - exitPx
            s1Trades += 1
            s1TotPts += pts
            if pts >= 0
                s1Wins += 1
            else
                s1Losses += 1
            s1ExitEvt := true
            s1ExitPts := pts
            f_alert("SCEN 5PX_1o_15PM SHORT exit @ " + str.tostring(math.round(exitPx)) + " (" + (pts >= 0 ? "+" : "") + str.tostring(pts, "#.##") + " pts)")
            s1State := 0
            s1Entry := na
    // entries (flat only — exits above may free the state on the same bar)
    if s1State == 0
        bool s1Long  = s1supRecent and s1pxWin > 0 and s1pxUp and s1vocArm >= 0 and s1pm15Up
        bool s1Short = s1resRecent and s1pxWin > 0 and not s1pxUp and s1vocArm >= 0 and s1pm15Dn
        if s1Long
            s1State := 1
            s1Entry := close
            s1EntUp := true
            f_alert("SCEN 5PX_1o_15PM LONG @ " + str.tostring(math.round(close)))
        else if s1Short
            s1State := -1
            s1Entry := close
            s1EntDn := true
            f_alert("SCEN 5PX_1o_15PM SHORT @ " + str.tostring(math.round(close)))

