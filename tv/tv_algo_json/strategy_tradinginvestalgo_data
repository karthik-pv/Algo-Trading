// --------------------
// Helper function
// --------------------
f_json_pair(key, val) =>
    "\"" + key + "\":" + str.tostring(val)

f_json_pair_str(key, val) =>
    "\"" + key + "\":\"" + val + "\""


f_calc_all() =>
    //PVT
    raw_pvt = calc_pvt(pvt_maType, close, pvt_short, pvt_long)
    maxAbs_pvt = maxAbs(raw_pvt, pvt_normalizeLookback)
    range_pvt = 1.0 // range to fit values into
    value_pvt= pvt_shouldNormalize? raw_pvt / maxAbs_pvt * range_pvt: raw_pvt
    
    pvt_poise_flag = value_pvt > value_pvt[1] ? 1 : -1
    pvt_trend_flag = value_pvt > 0 ? 1 : -1
    pvt_cross_over_index = ta.barssince(ta.crossover(value_pvt,0))+1
    pvt_cross_under_index = ta.barssince(ta.crossunder(value_pvt,0))+1
    
    //EMAs
    ema9   = ta.ema(close, 9)
    ema21  = ta.ema(close, 21)
    ema50  = ta.ema(close, 50)
    ema100 = ta.ema(close, 100)
    ema200 = ta.ema(close, 200)

    //MACD
    fastMA     = ta.ema(close, 24)
    slowMA     = ta.ema(close, 52)
    macdDiff   = fastMA - slowMA
    macdSignal = ta.ema(macdDiff, 9)
    macdHist   = macdDiff - macdSignal

    fastMA1     = ta.ema(close, 12)
    slowMA1     = ta.ema(close, 26)
    macdDiff1   = fastMA1 - slowMA1
    macdSignal1 = ta.ema(macdDiff1, 9)
    macdHist1   = macdDiff1 - macdSignal1

    [macdline_2452, signalLine_2452, histLine_2452] = ta.macd(close, 24, 52, 9)
    [macdline_1226, signalLine_1226, histLine_1226] = ta.macd(close, 12, 26, 9)
    
    crossTrend = ""
    zCrossFlag = 0

    if macdline_1226 < signalLine_1226 and macdline_1226  > macdline_1226[1] and macdline_2452 < signalLine_2452 and macdline_2452  > macdline_2452[1]
        zCrossFlag := 3
        crossTrend := "U"
    else if macdline_1226 < signalLine_1226 and macdline_1226  > macdline_1226[1]
        zCrossFlag := 1  
        crossTrend := "U"          
    else if macdline_2452 < signalLine_2452 and macdline_2452  > macdline_2452[1]
        zCrossFlag := 2
        crossTrend := "U"
    
    if macdline_1226 > signalLine_1226 and macdline_1226  < macdline_1226[1] and macdline_2452 > signalLine_2452 and macdline_2452  < macdline_2452[1]
        zCrossFlag := -3
    else if macdline_1226 > signalLine_1226 and macdline_1226  < macdline_1226[1]
        zCrossFlag := -1            
    else if macdline_2452 > signalLine_2452 and macdline_2452  < macdline_2452[1]
        zCrossFlag := -2


    trend_1226 = macdline_1226 >  signalLine_1226 ? 1: -1
    x_1226 = ta.barssince(ta.crossover(macdline_1226,signalLine_1226))+1
    y_1226 = ta.barssince(ta.crossunder(macdline_1226,signalLine_1226))+1

    trend_2452 = macdline_2452 >  signalLine_2452 ? 1: -1
    x_2452 = ta.barssince(ta.crossover(macdline_2452,signalLine_2452))+1
    y_2452 = ta.barssince(ta.crossunder(macdline_2452,signalLine_2452))+1
    
    //STOCHASTIC

    k = ta.sma(ta.stoch(ta.rsi(close, 14), ta.rsi(close, 14), ta.rsi(close, 14), 14), 6)
    d = ta.sma(ta.sma(ta.stoch(ta.rsi(close, 14), ta.rsi(close, 14), ta.rsi(close, 14), 14), 6), 6)
    k_trend_flag = k > d ? 1 :-1
    stoch_poise_flag = k>k[1] ? 1: -1
    k_crossover_index = ta.barssince(ta.crossover(k,d))+1
    k_crossunder_index = ta.barssince(ta.crossunder(k,d))+1

    //VWAP
    vwap_val = ta.vwap(hlc3)


    //VOC
    short = ta.ema(volume, 9)
    long = ta.ema(volume, 21)
    voc = 100 * (short - long) / long
    voc_trend_flag = voc>voc[1] ? 1:-1
    voc_cross_over_index = ta.barssince(ta.crossover(voc,0))+1
    voc_cross_under_index = ta.barssince(ta.crossunder(voc,0))+1

    [value_pvt,pvt_poise_flag,pvt_trend_flag,pvt_cross_over_index,pvt_cross_under_index, trend_1226,x_1226,y_1226,macdline_1226,signalLine_1226, histLine_1226,trend_2452,x_2452,y_2452, macdline_2452, signalLine_2452, histLine_2452,zCrossFlag,k,k_trend_flag,stoch_poise_flag,k_crossover_index,k_crossunder_index,ema9, ema21, ema50, ema100, ema200,vwap_val,voc,voc_trend_flag,voc_cross_over_index,voc_cross_under_index ]
 
// --------------------

// v1.4: compact Weekly / Daily / Quarterly PM blocks - PVT + MACD2 (24/52)
// state only, for the Levels-Ladder chips (WPM / MPM / QPM2). Small on
// purpose (~150 chars each) to stay clear of the 4096-char alert cap.
f_pm_state() =>
    [calc_pvt(pvt_maType, close, pvt_short, pvt_long) > 0 ? 1 : -1, ta.ema(close, 24) - ta.ema(close, 52) > ta.ema(ta.ema(close, 24) - ta.ema(close, 52), 9) ? 1 : -1]

[pvt_w, trend2452_w] = request.security(DATA_SYM, "W", f_pm_state())
[pvt_q, trend2452_q] = request.security(DATA_SYM, "3M", f_pm_state())
[pvt_d_c, trend2452_d_c] = request.security(DATA_SYM, "D", f_pm_state())

// v1.12: full family state (PVT sign + MACD1 12/26 + MACD2 24/52) for the
// Levels-Ladder FAM tag column - mirrors SPATAM's f_levelTag families. Only
// M and Q need new security calls; 5m/30m/2h/D/W reuse the f_calc_all tuples
// above (value_pvt_5m / trend_1226_5m / ... / trend_2452_w).
f_fam_state() =>
    [macdline_1226, signalLine_1226, _h1] = ta.macd(close, 12, 26, 9)
    [macdline_2452, signalLine_2452, _h2] = ta.macd(close, 24, 52, 9)
    [calc_pvt(pvt_maType, close, pvt_short, pvt_long) > 0 ? 1 : -1, macdline_1226 > signalLine_1226 ? 1 : -1, macdline_2452 > signalLine_2452 ? 1 : -1]

[fam_pvt_m, fam_m1_m, fam_m2_m] = request.security(DATA_SYM, "M", f_fam_state())
[fam_pvt_q, fam_m1_q, fam_m2_q] = request.security(DATA_SYM, "3M", f_fam_state())

// v1.9: price-crossing-VWAP cross ages for the Momentors rows 1CVX (1m,
