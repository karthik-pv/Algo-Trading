// v1.3: computed FROM DATA_SYM so non-NSE charts never leak their own
// VWAP/session values. The OR/VWAP state machine runs inside the security
// context of the pinned symbol (NSE session, NSE volume).
f_orAndVwaps() =>
    var float orH = na
    var float orL = na
    if ta.change(time("D")) != 0
        orH := na
        orL := na
    float minsSinceOpen = (time - time("D")) / 60000.0
    if minsSinceOpen >= 0 and minsSinceOpen <= orMinutes
        orH := na(orH) ? high : math.max(orH, high)
        orL := na(orL) ? low : math.min(orL, low)
    var float wPV = 0.0
    var float wVV = 0.0
    if ta.change(time("W")) != 0
        wPV := 0.0
        wVV := 0.0
    wPV += hlc3 * volume
    wVV += volume
    [orH, orL, ta.vwap, wVV > 0 ? wPV / wVV : na]
