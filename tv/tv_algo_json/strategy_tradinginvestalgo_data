f_vwap_cross() =>
    v = ta.vwap(hlc3)
    [ta.barssince(ta.crossover(close, v)) + 1, ta.barssince(ta.crossunder(close, v)) + 1]
[vwapxo_1m, vwapxu_1m] = request.security(DATA_SYM, "1M", f_vwap_cross())
[vwapxo_5m, vwapxu_5m] = request.security(DATA_SYM, "5M", f_vwap_cross())
