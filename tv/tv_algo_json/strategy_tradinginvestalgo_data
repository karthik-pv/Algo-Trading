// --------------------


[value_pvt_5s,pvt_poise_flag_5s,pvt_trend_flag_5s,pvt_cross_over_index_5s,pvt_cross_under_index_5s, trend_1226_5s,x_1226_5s,y_1226_5s,macdline_1226_5s,signalLine_1226_5s, histLine_1226_5s,trend_2452_5s,x_2452_5s,y_2452_5s, macdline_2452_5s, signalLine_2452_5s, histLine_2452_5s,zCrossFlag_5s,k_5s,k_trend_flag_5s,stoch_poise_flag_5s,k_crossover_index_5s,k_crossunder_index_5s,ema9_5s, ema21_5s, ema50_5s, ema100_5s, ema200_5s,vwap_val_5s,voc_5s,voc_trend_flag_5s,voc_cross_over_index_5s,voc_cross_under_index_5s ] = request.security(DATA_SYM, "5S",f_calc_all() )
