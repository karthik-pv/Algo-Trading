//PVT------------------------------------------------------------------------------------------

kEma = "EMA"
kSma = "SMA"
kVwma = "VWMA"
kWma = "WMA"


// Input
pvt_maType = kEma 
pvt_short = 3
pvt_long = 10
pvt_showTrend = false
pvt_showFill = true
pvt_showMa = true
pvt_oscMaType = kSma
pvt_maLength = 13
pvt_cross = true
pvt_shouldNormalize = true
pvt_normalizeLookback = 25

smooth(t, sig, len) =>
    ma = float(sig)         // None
    if t == kSma            // Simple
        ma := ta.sma(sig, len)
    if t == kEma            // Exponential
        ma := ta.ema(sig, len)
    if t == kWma            // Weighted
        ma := ta.wma(sig, len)
    if t == kVwma           // Volume Weighted
        ma := ta.vwma(sig, len)
    ma

calc_pvt(ma, sig, short, long) =>
    src = sig
    vt = ta.cum(ta.change(src) / src[1] * volume)
    sh = smooth(ma, vt, short)
    lg = smooth(ma, vt, long)
    sh - lg


maxAbs(series, len) =>
    max = float(0)
    for i = 0 to len-1
        max := math.max(max, math.abs(series[i]))
    max

pvt_stats()=>
    raw_pvt = calc_pvt(pvt_maType, close, pvt_short, pvt_long)
    maxAbs_pvt = maxAbs(raw_pvt, pvt_normalizeLookback)
    range_pvt = 1.0 // range to fit values into
    value_pvt= pvt_shouldNormalize? raw_pvt / maxAbs_pvt * range_pvt: raw_pvt
    
    pvt_poise_flag = value_pvt > value_pvt[1] ? 1 : -1
    pvt_trend_flag = value_pvt > 0 ? 1 : -1
    pvt_cross_over_index = ta.barssince(ta.crossover(value_pvt,0))+1
    pvt_cross_under_index = ta.barssince(ta.crossunder(value_pvt,0))+1
    
    [value_pvt,pvt_poise_flag,pvt_trend_flag,pvt_cross_over_index,pvt_cross_under_index]

pvt(_res)=>
    [value_pvt1,pvt_poise_flag1,pvt_trend_flag1,pvt_cross_over_index1,pvt_cross_under_index1] = request.security(DATA_SYM, _res,pvt_stats() , lookahead = barmerge.lookahead_on)
    
get_pvt_bgcolor(value_pvt)=>
    (value_pvt < 0.1 and value_pvt > -0.1) ? color.yellow: value_pvt > 0.1 ? color.green : color.red


//PVT------------------------------------------------------------------------------------------

get_Close_EMA200_Stats()=>
    (close - ta.ema(close,200)) *100 / close

get_Close_EMA200_Stats_res(_res)=>
    request.security(DATA_SYM, _res,get_Close_EMA200_Stats() , lookahead = barmerge.lookahead_on)
    
//EMA200---------------------------------------------------------------------------------------

roundn(x, n) => 
    mult = 1 
    if n != 0
        for i = 1 to math.abs(n)
            mult := mult * 10
    
    n >= 0 ? math.round(x * mult) / mult : math.round(x / mult) * mult 

//GETTING VALUES FOR ALL TIMEFRAMES-------------------------------------------------------

pad_tostring(num,reqLength) => 
    if reqLength - str.length(str.tostring(num)) == 1
        " " + str.tostring(num)
    else if reqLength - str.length(str.tostring(num)) == 2
        "  " + str.tostring(num)
    else if reqLength - str.length(str.tostring(num)) == 3
        "   " + str.tostring(num)
    else if reqLength - str.length(str.tostring(num)) == 4
        "    " + str.tostring(num)
    else if reqLength - str.length(str.tostring(num)) == 5
        "     " + str.tostring(num)
    else if reqLength - str.length(str.tostring(num)) == 6
        "      " + str.tostring(num)

