// compact pair format keeps the LEVELS alert under TradingView's 4096-char message limit
f_levelsJson(lv) =>
    string out = "["
    int n = array.size(lv)
    if n > 0
        for i = 0 to n - 1
            parts = str.split(array.get(lv, i), "_")
            out += "[\"" + array.get(parts, 1) + "\"," + str.tostring(str.tonumber(array.get(parts, 0))) + "]"
            out += (i < n - 1 ? "," : "")
    out += "]"
    out

