// column (f_familyTag), plus the two color bits the table shade carries:
//   <tag> + U/D (PVT direction) + 1/0 (dark shade = MACD2 agrees with PVT).
// The Algo app prints the tag verbatim and maps (direction, dark) to the
// same colors SPATAM uses (dark/light green-red).
f_tag_seg(int _pvt, int _m1, int _m2, string _pfx) =>
    int pDir = _pvt > 0 ? 1 : -1
    bool m1With = _m1 == pDir
    bool m2With = _m2 == pDir
    _pfx + "P" + (m2With ? (m1With ? "M" : "M2") : m1With ? "M1" : "") + (pDir == 1 ? "U" : "D") + (m2With ? "1" : "0")

