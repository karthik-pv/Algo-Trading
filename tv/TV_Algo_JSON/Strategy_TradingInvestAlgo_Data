// Floor pivots from the PREVIOUS COMPLETED period - fixed for the whole period, non-repainting
get_PrevPeriodPivots() =>
    prevHigh = high[1]
    prevLow = low[1]
    prevClose = close[1]

    P = (prevHigh + prevLow + prevClose) / 3
    R1 = P * 2 - prevLow
    S1 = P * 2 - prevHigh
    R2 = P + (prevHigh - prevLow)
    S2 = P - (prevHigh - prevLow)
    R3 = P * 2 + (prevHigh - 2 * prevLow)
    S3 = P * 2 - (2 * prevHigh - prevLow)
    R4 = P * 3 + (prevHigh - 3 * prevLow)
    S4 = P * 3 - (3 * prevHigh - prevLow)
    R5 = P * 4 + (prevHigh - 4 * prevLow)
    S5 = P * 4 - (4 * prevHigh - prevLow)

    [P,R1,R2,R3,R4,R5,S1,S2,S3,S4,S5]

// Developing-period OHLC pivots - used as the next day/week projection
getNextPivotResistanceLevels()=>
    curHigh = high
    curLow = low
    curOpen = open
    curClose = close

    P = (curHigh + curLow + curClose) / 3
    R1 = P * 2 - curLow
    S1 = P * 2 - curHigh
    R2 = P + (curHigh - curLow)
    S2 = P - (curHigh - curLow)
    R3 = P * 2 + (curHigh - 2 * curLow)
    S3 = P * 2 - (2 * curHigh - curLow)
    R4 = P * 3 + (curHigh - 3 * curLow)
    S4 = P * 3 - (3 * curHigh - curLow)
    R5 = P * 4 + (curHigh - 4 * curLow)
    S5 = P * 4 - (4 * curHigh - curLow)

    [P,R1,R2,R3,R4,R5,S1,S2,S3,S4,S5]

